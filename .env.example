# BF Personal App settings. Copy this file to .env.local for local use, and enter the same names
# and values in Vercel (Project, Settings, Environment Variables). Never commit real values.

# --- Supabase (database, sign-in, document storage) ---
# Supabase project, Settings, API: "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase project, Settings, API: "anon public" key. Safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project, Settings, API: "service_role" key. Server only. Used by scheduled jobs and the partner report page.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner ---
# The only email allowed to create an account and sign in.
OWNER_EMAIL=bram@cyanarc.com
# The app's web address with no trailing slash (Vercel domain), used for Google sign-in and partner links.
APP_URL=https://bf-personal-app.vercel.app

# --- Security ---
# Random secret that Vercel Cron sends to the scheduled job routes. Any long random text.
CRON_SECRET=
# Key that encrypts saved Google and Plaid access tokens and partner links. 64 hexadecimal characters.
# Create one with: openssl rand -hex 32   (keep it; changing it means reconnecting Google and Plaid)
TOKEN_ENCRYPTION_KEY=

# --- AI (Anthropic API) ---
# console.anthropic.com, API Keys. Leave empty to run the app without the AI (plain drafts are used instead).
ANTHROPIC_API_KEY=
# Model used for every AI request.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Upper limit for AI spending per calendar month, in US dollars. The cap in Settings can be lower, never higher.
AI_MONTHLY_CAP_USD=25
# Prices used to calculate the cost of each AI call (US dollars per million tokens). Match them to the model's current price.
AI_INPUT_PRICE_PER_MTOK=3
AI_OUTPUT_PRICE_PER_MTOK=15

# --- Google (Gmail drafts and Calendar) ---
# Google Cloud Console, APIs and Services, Credentials, OAuth client (Web application).
# Authorized redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Plaid (bank feed, after week 1). Leave empty until then; Settings shows "Not connected yet". ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox for testing, production for real accounts.
PLAID_ENV=sandbox
